APP_ENV=local
APP_HOST=
APP_PORT=8080

# Supported values: memory, postgres.
STORAGE_DRIVER=postgres

# Used when STORAGE_DRIVER=postgres.
DATABASE_URL=postgres://fitness:fitness@localhost:5432/fitness_tracker?sslmode=disable

# Optional DB settings for building DATABASE_URL from parts.
DB_HOST=localhost
DB_PORT=5432
DB_USER=fitness
DB_PASSWORD=fitness
DB_NAME=fitness_tracker
DB_SSLMODE=disable
