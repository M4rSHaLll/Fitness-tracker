APP_ENV=local
APP_HOST=
APP_PORT=8080

# Supported values: memory, postgres.
STORAGE_DRIVER=postgres
INTERNAL_API_TOKEN=change-me-local-internal-token
API_TOKEN=change-me-local-api-token
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling

# Used when STORAGE_DRIVER=postgres.
DATABASE_URL=postgres://fitness:fitness@localhost:55432/fitness_tracker?sslmode=disable

# Optional DB settings for building DATABASE_URL from parts.
DB_HOST=localhost
DB_PORT=55432
DB_USER=fitness
DB_PASSWORD=fitness
DB_NAME=fitness_tracker
DB_SSLMODE=disable

# Optional proxy for Telegram API access from Docker Desktop.
# HTTPS_PROXY=http://host.docker.internal:7890
